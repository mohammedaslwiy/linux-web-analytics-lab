# Created locally by: bash scripts/init_env.sh
DB_NAME=umami
DB_USER=umami
DB_PASSWORD=CHANGE_ME
APP_SECRET=CHANGE_ME
WEB_PORT=9090
UMAMI_PORT=9000
# Keep the learning environment local. For a remote VM use an SSH tunnel.
BIND_ADDRESS=127.0.0.1
VM_IP_OR_DOMAIN=localhost
# Set after adding a website in Umami. Blank disables the tracker.
UMAMI_WEBSITE_ID=
